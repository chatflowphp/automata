{
    "name": "chatflowphp/automata",
    "description": "Framework-agnostic state machine runtime for persistent step-by-step flows in PHP: chat dialogs, wizards, workflows.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "state-machine",
        "finite-state-machine",
        "fsm",
        "workflow",
        "chatbot",
        "dialog",
        "wizard",
        "snapshot",
        "event-driven"
    ],
    "homepage": "https://github.com/chatflowphp/automata",
    "readme": "README.md",
    "authors": [
        {
            "name": "Alex",
            "email": "webnarmin@gmail.com",
            "role": "maintainer",
            "homepage": "https://github.com/webnarmin"
        }
    ],
    "support": {
        "issues": "https://github.com/chatflowphp/automata/issues",
        "source": "https://github.com/chatflowphp/automata"
    },
    "require": {
        "php": ">=8.1",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Automata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Automata\\Tests\\": "tests/",
            "AutomataExamples\\SimpleWorkflow\\": "examples/simple-workflow/src/",
            "AutomataExamples\\SurveyBot\\": "examples/survey-bot/src/",
            "AutomataExamples\\TrafficLight\\": "examples/traffic-light/src/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "test": "phpunit",
        "check": [
            "@composer validate --strict",
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
